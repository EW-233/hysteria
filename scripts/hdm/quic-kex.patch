+// 生成带真实 AEAD 和头保护的路径帧，不绕过收包鉴权来验证 packetInfo 来源。
+func externalTestProbe(t *testing.T, crypto *handshake.ExternalCryptoSetup, pn protocol.PacketNumber, challenge, response *[8]byte) []byte {
+	t.Helper()
+	sealer, err := crypto.Get1RTTSealer()
+	require.NoError(t, err)
+	header, err := wire.AppendShortHeader(nil, protocol.ParseConnectionID(bytes.Repeat([]byte{2}, 16)), pn, protocol.PacketNumberLen4, protocol.KeyPhaseZero)
+	require.NoError(t, err)
+	var payload []byte
+	if challenge != nil {
+		payload, err = (&wire.PathChallengeFrame{Data: *challenge}).Append(payload, protocol.Version1)
+		require.NoError(t, err)
+	}
+	if response != nil {
+		payload, err = (&wire.PathResponseFrame{Data: *response}).Append(payload, protocol.Version1)
+		require.NoError(t, err)
+	}
+	payload = append(payload, make([]byte, 1200-len(header)-sealer.Overhead()-len(payload))...)
+	packet := sealer.Seal(header, payload, pn, header)
+	sealer.EncryptHeader(packet[len(header):len(header)+16], &packet[0], packet[len(header)-4:len(header)])
+	return packet
+}
+
+func TestExternalProbePreservesAuthenticatedPacketInfo(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	tc := newServerTestConnection(t, ctrl, nil, false)
+	c := tc.conn
+	c.cryptoStreamHandler = handshake.NewExternalCryptoSetup([32]byte{1}, [32]byte{2}, utils.NewRTTStats())
+	c.unpacker = newPacketUnpacker(c.cryptoStreamHandler.(*handshake.ExternalCryptoSetup), 16)
+	c.externalPath = &externalPathState{server: true, candidates: make(map[netip.AddrPort]*externalCandidate), hooks: &ExternalPathHooks{
+		Authenticated: func(netip.AddrPort, int) error { return nil }, Challenge: func(netip.AddrPort) ([8]byte, error) { return [8]byte{7}, nil },
+		ReserveSend: func(netip.AddrPort, int) error { return nil }, Validated: func(netip.AddrPort, [8]byte) error { return nil },
+	}}
+	peer := handshake.NewExternalCryptoSetup([32]byte{2}, [32]byte{1}, utils.NewRTTStats())
+	challenge := [8]byte{9}
+	addresses := []netip.AddrPort{netip.MustParseAddrPort("192.0.2.10:1000"), netip.MustParseAddrPort("192.0.2.20:2000")}
+	infos := []packetInfo{{addr: netip.MustParseAddr("198.51.100.1")}, {addr: netip.MustParseAddr("198.51.100.2")}}
+	for i, a := range addresses {
+		packet := receivedPacket{remoteAddr: net.UDPAddrFromAddrPort(a), rcvTime: monotime.Now(), info: infos[i], data: externalTestProbe(t, peer, protocol.PacketNumber(i), &challenge, nil)}
+		verified, err := c.handleExternalProbe(packet)
+		require.NoError(t, err)
+		require.False(t, verified)
+		require.Equal(t, infos[i], c.externalPath.candidates[a].info)
+		tc.sendConn.EXPECT().WriteTo(gomock.Any(), net.UDPAddrFromAddrPort(a), infos[i]).Return(nil)
+		require.NoError(t, c.sendExternalProbe(a, c.externalPath.candidates[a]))
+	}
+	// 伪造的来源元数据不能覆盖已经通过 AEAD 的候选信息。
+	bad := receivedPacket{remoteAddr: net.UDPAddrFromAddrPort(addresses[0]), info: infos[1], rcvTime: monotime.Now(), data: bytes.Repeat([]byte{0x40}, 1200)}
+	verified, err := c.handleExternalProbe(bad)
+	require.NoError(t, err)
+	require.False(t, verified)
+	require.Equal(t, infos[0], c.externalPath.candidates[addresses[0]].info)
+	response := [8]byte{7}
+	tc.sendConn.EXPECT().ChangeRemoteAddr(net.UDPAddrFromAddrPort(addresses[0]), infos[0])
+	verified, err = c.handleExternalProbe(receivedPacket{remoteAddr: net.UDPAddrFromAddrPort(addresses[0]), info: infos[0], rcvTime: monotime.Now(), data: externalTestProbe(t, peer, 2, &challenge, &response)})
+	require.NoError(t, err)
+	require.True(t, verified)
+	require.Equal(t, infos[0], c.externalPath.info)
+}
