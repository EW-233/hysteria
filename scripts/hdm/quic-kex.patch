+// 在真实主循环关闭后向旧 CID 发送异源包，确认 Transport 中的关闭处理器也受到限制。
+func TestExternalNetworkClosedConnectionRejectsForeignSource(t *testing.T) {
+	_, server, _, ss := externalNetworkTestPair(t)
+	require.NoError(t, server.CloseWithError(0x100, "external authorization ended"))
+	foreign := externalTestSocket(t)
+	packet := append([]byte{0x40}, make([]byte, 16)...)
+	packet[1] = 2
+	for range 8 {
+		_, err := foreign.WriteTo(packet, ss.LocalAddr())
+		require.NoError(t, err)
+	}
+	require.NoError(t, foreign.SetReadDeadline(time.Now().Add(80*time.Millisecond)))
+	var buffer [256]byte
+	_, _, err := foreign.ReadFrom(buffer[:])
+	var timeout net.Error
+	require.ErrorAs(t, err, &timeout)
+	require.True(t, timeout.Timeout(), "异源不应收到 CLOSE")
+}
