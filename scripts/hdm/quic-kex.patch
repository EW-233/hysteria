+func TestExternalPeerKeyUpdateCancellationAndPathGate(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	c := &Conn{}
+	require.ErrorIs(t, c.AllowExternalPeerKeyUpdate(ctx), context.Canceled)
+	require.Error(t, c.AllowExternalPeerKeyUpdate(context.Background()))
+	c.ctx = context.Background()
+	c.externalPath = &externalPathState{ready: make(chan struct{})}
+	waiting, stop := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer stop()
+	require.ErrorIs(t, c.AllowExternalPeerKeyUpdate(waiting), context.DeadlineExceeded)
+	c.externalAllowPeerKeyUpdate = make(chan externalKeyUpdateRequest, 1)
+	req := externalKeyUpdateRequest{ctx: context.Background(), result: make(chan error, 1)}
+	c.externalAllowPeerKeyUpdate <- req
+	c.processExternalConfirmation()
+	require.Error(t, <-req.result)
+	c.externalPath.verified = true
+	req = externalKeyUpdateRequest{ctx: ctx, result: make(chan error, 1)}
+	c.externalAllowPeerKeyUpdate <- req
+	c.processExternalConfirmation()
+	require.ErrorIs(t, <-req.result, context.Canceled)
+}
