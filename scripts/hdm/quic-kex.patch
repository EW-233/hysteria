+// 记录实际 UDP 输出，并可确定性丢弃包，验证没有 Initial 与可靠流恢复。
+type externalTestPacketConn struct {
+	net.PacketConn
+	mu      sync.Mutex
+	packets [][]byte
+	drop    int
+	count   int
+}
+
+func (p *externalTestPacketConn) WriteTo(b []byte, addr net.Addr) (int, error) {
+	p.mu.Lock()
+	p.count++
+	p.packets = append(p.packets, bytes.Clone(b))
+	drop := p.drop > 0 && p.count%p.drop == 0
+	p.mu.Unlock()
+	if drop {
+		return len(b), nil
+	}
+	return p.PacketConn.WriteTo(b, addr)
+}
+func externalTestSocket(t *testing.T) *externalTestPacketConn {
+	t.Helper()
+	c, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { c.Close() })
+	return &externalTestPacketConn{PacketConn: c}
+}
+func externalTestConfig() *Config {
+	return &Config{EnableDatagrams: true, MaxIdleTimeout: 5 * time.Second, InitialStreamReceiveWindow: 64 * 1024, InitialConnectionReceiveWindow: 128 * 1024}
+}
+func externalTestPair(t *testing.T, drop int, parents ...context.Context) (*Conn, *Conn, *externalTestPacketConn, *externalTestPacketConn) {
+	t.Helper()
+	var clientCID, serverCID [16]byte
+	var clientKey, serverKey [32]byte
+	_, err := rand.Read(clientCID[:])
+	require.NoError(t, err)
+	_, err = rand.Read(serverCID[:])
+	require.NoError(t, err)
+	_, err = rand.Read(clientKey[:])
+	require.NoError(t, err)
+	_, err = rand.Read(serverKey[:])
+	require.NoError(t, err)
+	clientSocket := externalTestSocket(t)
+	serverSocket := externalTestSocket(t)
+	clientSocket.drop = drop
+	serverSocket.drop = drop
+	ct := &Transport{Conn: clientSocket}
+	st := &Transport{Conn: serverSocket}
+	t.Cleanup(func() { ct.Close(); st.Close() })
+	cfg := externalTestConfig()
+	cp, err := ExternalLoopbackParameters(false, clientCID, serverCID, cfg)
+	require.NoError(t, err)
+	sp, err := ExternalLoopbackParameters(true, serverCID, clientCID, cfg)
+	require.NoError(t, err)
+	parent := context.Background()
+	if len(parents) > 0 {
+		parent = parents[0]
+	}
+	ctx, cancel := context.WithCancel(parent)
+	t.Cleanup(cancel)
+	server, err := st.NewExternalLoopback(ctx, clientSocket.LocalAddr(), cfg, ExternalLoopbackConfig{Server: true, LocalCID: serverCID, PeerCID: clientCID, ReadSecret: clientKey, WriteSecret: serverKey, PeerParameters: cp})
+	require.NoError(t, err)
+	client, err := ct.NewExternalLoopback(ctx, serverSocket.LocalAddr(), cfg, ExternalLoopbackConfig{LocalCID: clientCID, PeerCID: serverCID, ReadSecret: serverKey, WriteSecret: clientKey, PeerParameters: sp})
+	require.NoError(t, err)
+	return client, server, clientSocket, serverSocket
+}
+func externalTestExchange(t *testing.T, client, server *Conn, payload []byte) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	received := make(chan error, 1)
+	go func() {
+		stream, err := server.AcceptStream(ctx)
+		if err != nil {
+			received <- err
+			return
+		}
+		stream.SetDeadline(time.Now().Add(5 * time.Second))
+		b, err := io.ReadAll(stream)
+		if err != nil {
+			received <- err
+			return
+		}
+		if !bytes.Equal(b, payload) {
+			received <- io.ErrUnexpectedEOF
+			return
+		}
+		_, err = stream.Write(b)
+		if err == nil {
+			err = stream.Close()
+		}
+		received <- err
+	}()
+	stream, err := client.OpenStreamSync(ctx)
+	require.NoError(t, err)
+	require.NoError(t, stream.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err = stream.Write(payload)
+	require.NoError(t, err)
+	require.NoError(t, stream.Close())
+	b, err := io.ReadAll(stream)
+	require.NoError(t, err)
+	require.Equal(t, payload, b)
+	require.NoError(t, <-received)
+}
+
+func TestExternalLoopbackStreamsAndDatagrams(t *testing.T) {
+	client, server, cs, ss := externalTestPair(t, 0)
+	externalTestExchange(t, client, server, []byte("client-confirm"))
+	require.False(t, client.ConnectionState().TLS.HandshakeComplete)
+	require.False(t, server.ConnectionState().TLS.HandshakeComplete)
+	// 普通 1-RTT ACK 不能代替外部协议的业务就绪确认。
+	select {
+	case <-client.externalConfirmed:
+		t.Fatal("client confirmed by ACK")
+	default:
+	}
+	select {
+	case <-server.externalConfirmed:
+		t.Fatal("server confirmed by ACK")
+	default:
+	}
+	require.NoError(t, client.ConfirmExternalLoopback(context.Background()))
+	require.NoError(t, server.ConfirmExternalLoopback(context.Background()))
+	externalTestExchange(t, client, server, bytes.Repeat([]byte("stream-flow-control"), 18000))
+	require.NoError(t, client.SendDatagram([]byte("datagram")))
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	b, err := server.ReceiveDatagram(ctx)
+	require.NoError(t, err)
+	require.Equal(t, []byte("datagram"), b)
+	require.NoError(t, server.SendDatagram([]byte("reply")))
+	b, err = client.ReceiveDatagram(ctx)
+	require.NoError(t, err)
+	require.Equal(t, []byte("reply"), b)
+	require.NoError(t, client.CloseWithError(0, "done"))
+	for _, s := range []*externalTestPacketConn{cs, ss} {
+		s.mu.Lock()
+		packets := append([][]byte(nil), s.packets...)
+		s.mu.Unlock()
+		require.NotEmpty(t, packets)
+		for _, p := range packets {
+			require.Zero(t, p[0]&0x80, "long header emitted")
+			require.Equal(t, byte(0x40), p[0]&0x40)
+		}
+	}
+}
+func TestExternalLoopbackLossRecovery(t *testing.T) {
+	client, server, _, _ := externalTestPair(t, 5)
+	require.NoError(t, client.ConfirmExternalLoopback(context.Background()))
+	require.NoError(t, server.ConfirmExternalLoopback(context.Background()))
+	externalTestExchange(t, client, server, bytes.Repeat([]byte("loss"), 100000))
+}
+func TestExternalLoopbackRejectsUnsafeInputs(t *testing.T) {
+	socket := externalTestSocket(t)
+	tr := &Transport{Conn: socket}
+	defer tr.Close()
+	cid1, cid2 := [16]byte{1}, [16]byte{2}
+	cfg := externalTestConfig()
+	params, err := ExternalLoopbackParameters(true, cid2, cid1, cfg)
+	require.NoError(t, err)
+	x := ExternalLoopbackConfig{LocalCID: cid1, PeerCID: cid2, ReadSecret: [32]byte{3}, WriteSecret: [32]byte{4}, PeerParameters: params}
+	_, err = tr.NewExternalLoopback(context.Background(), &net.UDPAddr{IP: net.IPv4(192, 0, 2, 1), Port: 8443}, cfg, x)
+	require.Error(t, err)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = tr.NewExternalLoopback(ctx, socket.LocalAddr(), cfg, x)
+	require.ErrorIs(t, err, context.Canceled)
+	bad := x
+	bad.PeerParameters = append(bytes.Clone(params), 0)
+	_, err = tr.NewExternalLoopback(context.Background(), socket.LocalAddr(), cfg, bad)
+	require.Error(t, err)
+	conn, err := tr.NewExternalLoopback(context.Background(), socket.LocalAddr(), cfg, x)
+	require.NoError(t, err)
+	_, err = tr.NewExternalLoopback(context.Background(), socket.LocalAddr(), cfg, x)
+	require.Error(t, err)
+	require.NoError(t, conn.CloseWithError(0, "done"))
+}
+
+func TestExternalLoopbackContextCancellation(t *testing.T) {
+	parent, cancel := context.WithCancel(context.Background())
+	client, server, _, _ := externalTestPair(t, 0, parent)
+	cancel()
+	select {
+	case <-client.Context().Done():
+	case <-time.After(time.Second):
+		t.Fatal("client did not cancel")
+	}
+	select {
+	case <-server.Context().Done():
+	case <-time.After(time.Second):
+		t.Fatal("server did not cancel")
+	}
+	require.ErrorIs(t, client.ConfirmExternalLoopback(parent), context.Canceled)
+}
+
+func TestExternalLoopbackRejectsReplayedNewSource(t *testing.T) {
+	client, server, cs, _ := externalTestPair(t, 0)
+	externalTestExchange(t, client, server, []byte("verify original path"))
+	original := server.RemoteAddr().String()
+	cs.mu.Lock()
+	packet := bytes.Clone(cs.packets[0])
+	cs.mu.Unlock()
+	attacker, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer attacker.Close()
+	_, err = attacker.WriteTo(packet, server.LocalAddr())
+	require.NoError(t, err)
+	require.NoError(t, attacker.SetReadDeadline(time.Now().Add(100*time.Millisecond)))
+	_, _, err = attacker.ReadFrom(make([]byte, 2048))
+	require.Error(t, err)
+	require.Equal(t, original, server.RemoteAddr().String())
+	externalTestExchange(t, client, server, []byte("original path still works"))
+}
+
+func TestExternalLoopbackIdleTimeout(t *testing.T) {
+	socket := externalTestSocket(t)
+	transport := &Transport{Conn: socket}
+	defer transport.Close()
+	cid1, cid2 := [16]byte{1}, [16]byte{2}
+	config := externalTestConfig()
+	config.MaxIdleTimeout = 100 * time.Millisecond
+	params, err := ExternalLoopbackParameters(true, cid2, cid1, config)
+	require.NoError(t, err)
+	sink := externalTestSocket(t)
+	conn, err := transport.NewExternalLoopback(context.Background(), sink.LocalAddr(), config, ExternalLoopbackConfig{LocalCID: cid1, PeerCID: cid2, ReadSecret: [32]byte{3}, WriteSecret: [32]byte{4}, PeerParameters: params})
+	require.NoError(t, err)
+	select {
+	case <-conn.Context().Done():
+	case <-time.After(2 * time.Second):
+		t.Fatal("idle timeout did not release connection")
+	}
+	require.Eventually(t, func() bool {
+		transport.mutex.Lock()
+		defer transport.mutex.Unlock()
+		return len(transport.handlers) == 0
+	}, time.Second, 10*time.Millisecond)
+}
