+package quic
+
+import (
+	"context"
+	"crypto/rand"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"time"
+
+	"github.com/apernet/quic-go/internal/handshake"
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+	"github.com/apernet/quic-go/internal/wire"
+)
+
+// ExternalPathHooks 由同进程接入管理器提供，回调必须有界且不得重入此连接。
+// 所有回调在连接主循环中执行；只有通过 AEAD 的实际数据报才增加预算。
+type ExternalPathHooks struct {
+	Authenticated func(netip.AddrPort, int) error
+	Challenge     func(netip.AddrPort) ([8]byte, error)
+	ReserveSend   func(netip.AddrPort, int) error
+	Validated     func(netip.AddrPort, [8]byte) error
+}
+
+type externalCandidate struct {
+	challenge   [8]byte
+	response    [8]byte
+	hasResponse bool
+	info        packetInfo // 仅从通过 AEAD 的实际收包中保存本地目的地址与接口。
+}
+type externalPathState struct {
+	server     bool
+	deadline   time.Time
+	hooks      *ExternalPathHooks
+	candidates map[netip.AddrPort]*externalCandidate
+	ready      chan struct{}
+	verified   bool
+	info       packetInfo // 胜出路径的本地地址信息，也用于关闭后的受限回复。
+}
+
+// RegisterExternal 创建并登记预分配 CID；服务器 remote 必须为 nil，不能预信任 HTTP 来源。
+// 返回不代表可用；调用者须 AwaitExternalPath，再执行可靠业务 READY 协议。
+func (t *Transport) RegisterExternal(ctx context.Context, remote net.Addr, config *Config, x ExternalLoopbackConfig, deadline time.Time, hooks *ExternalPathHooks) (*Conn, error) {
+	if deadline.IsZero() || !time.Now().Before(deadline) || time.Until(deadline) > 10*time.Second || t.Conn == nil {
+		return nil, errors.New("external QUIC: invalid path deadline")
+	}
+	path := &externalPathState{server: x.Server, deadline: deadline, candidates: make(map[netip.AddrPort]*externalCandidate), ready: make(chan struct{})}
+	if x.Server {
+		if remote != nil || hooks == nil || hooks.Authenticated == nil || hooks.Challenge == nil || hooks.ReserveSend == nil || hooks.Validated == nil {
+			return nil, errors.New("external QUIC: server admission hooks required")
+		}
+		copyHooks := *hooks
+		path.hooks = &copyHooks
+		// 未验证时不使用占位地址发送任何包；只有 PATH_RESPONSE 验证成功才替换目的地。
+		remote = &net.UDPAddr{IP: net.IPv4zero, Port: 1}
+	} else {
+		address, ok := externalUDPAddress(remote)
+		if !ok || hooks != nil {
+			return nil, errors.New("external QUIC: invalid client peer")
+		}
+		candidate := &externalCandidate{}
+		if _, err := rand.Read(candidate.challenge[:]); err != nil {
+			return nil, err
+		}
+		path.candidates[address] = candidate
+	}
+	return t.newExternal(ctx, remote, config, x, path)
+}
+
+func externalUDPAddress(addr net.Addr) (netip.AddrPort, bool) {
+	a, ok := addr.(*net.UDPAddr)
+	if !ok || a == nil || a.Port < 1 || a.Port > 65535 || a.Zone != "" {
+		return netip.AddrPort{}, false
+	}
+	ip, ok := netip.AddrFromSlice(a.IP)
+	if !ok {
+		return netip.AddrPort{}, false
+	}
+	ip = ip.Unmap()
+	return netip.AddrPortFrom(ip, uint16(a.Port)), !ip.IsUnspecified() && !ip.IsMulticast()
+}
+
+func (c *Conn) AwaitExternalPath(ctx context.Context) error {
+	if c.externalPath == nil {
+		return errors.New("external QUIC: no path verification")
+	}
+	select {
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	case <-c.externalPath.ready:
+		if c.ctx.Err() != nil {
+			return context.Cause(c.ctx)
+		}
+		return nil
+	}
+}
+
+type externalKeyUpdateRequest struct {
+	ctx    context.Context
+	result chan error
+}
+
+// AllowExternalPeerKeyUpdate 在认证 READY 后、发送 READY_ACK 前调用。
+// 仅允许解密对端更新；不确认握手、不开放业务，也不允许主动 key update。
+// 调用成功后许可保持至连接关闭，重复调用幂等；待路径验证阶段不能提前开放。
+func (c *Conn) AllowExternalPeerKeyUpdate(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := c.AwaitExternalPath(ctx); err != nil {
+		return err
+	}
+	request := externalKeyUpdateRequest{ctx: ctx, result: make(chan error, 1)}
+	select {
+	case c.externalAllowPeerKeyUpdate <- request:
+		c.scheduleSending()
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+	select {
+	case err := <-request.result:
+		return err
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+}
+
+// ConfirmExternal 由可靠 READY 控制协议调用；不能用路径成功或任意 ACK 代替业务确认。
+func (c *Conn) ConfirmExternal(ctx context.Context) error {
+	if c.externalPath == nil {
+		return errors.New("external QUIC: no network path")
+	}
+	if err := c.AwaitExternalPath(ctx); err != nil {
+		return err
+	}
+	response := make(chan error, 1)
+	select {
+	case c.externalConfirm <- response:
+		c.scheduleSending()
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+	select {
+	case err := <-response:
+		return err
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+}
+
+// verifyExternalPath 在普通发送循环之前运行：只发 1200 字节探测，每 250ms 最多每路径一包。
+// 服务器每次发送都预扣该实际来源的预算；未知 CID 由 Transport 丢弃，不会到达这里。
+func (c *Conn) verifyExternalPath() error {
+	state := c.externalPath
+	timer := time.NewTimer(time.Until(state.deadline))
+	defer timer.Stop()
+	tick := time.NewTicker(250 * time.Millisecond)
+	defer tick.Stop()
+	send := func() error {
+		for address, candidate := range state.candidates {
+			if err := c.sendExternalProbe(address, candidate); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := send(); err != nil {
+		return err
+	}
+	for {
+		if !time.Now().Before(state.deadline) {
+			return errors.New("external QUIC: path deadline exceeded")
+		}
+		// 每批有限处理，避免持续伪造流量饿死截止时间与取消信号。
+		for range 32 {
+			c.receivedPacketMx.Lock()
+			if c.receivedPackets.Empty() {
+				c.receivedPacketMx.Unlock()
+				break
+			}
+			packet := c.receivedPackets.PopFront()
+			c.receivedPacketMx.Unlock()
+			verified, err := c.handleExternalProbe(packet)
+			packet.buffer.Decrement()
+			packet.buffer.MaybeRelease()
+			if err != nil {
+				return err
+			}
+			if verified {
+				state.verified = true
+				clear(state.candidates)
+				c.lastPacketReceivedTime = monotime.Now()
+				close(state.ready)
+				return nil
+			}
+		}
+		select {
+		case <-c.closeChan:
+			return errors.New("external QUIC: path canceled")
+		case <-timer.C:
+			return errors.New("external QUIC: path deadline exceeded")
+		case <-tick.C:
+			if err := send(); err != nil {
+				return err
+			}
+		case <-c.notifyReceivedPacket:
+		}
+	}
+}
+
+// 先完成 AEAD，再按数据报来源处理路径帧。接入前丢弃业务帧且不 ACK，防止业务数据被吞掉。
+func (c *Conn) handleExternalProbe(packet receivedPacket) (bool, error) {
+	state := c.externalPath
+	address, valid := externalUDPAddress(packet.remoteAddr)
+	if !valid || len(packet.data) < 37 || packet.data[0]&0xc0 != 0x40 {
+		return false, nil
+	}
+	candidate := state.candidates[address]
+	if !state.server && candidate == nil {
+		return false, nil
+	}
+	size := len(packet.data)
+	pn, _, _, payload, err := c.unpacker.UnpackShortHeader(packet.rcvTime, packet.data)
+	if err != nil {
+		return false, nil
+	}
+	if c.receivedPacketHandler.IsPotentiallyDuplicate(pn, protocol.Encryption1RTT) {
+		return false, nil
+	}
+	if state.server {
+		if err := state.hooks.Authenticated(address, size); err != nil {
+			return false, nil
+		}
+		if candidate == nil {
+			if len(state.candidates) >= 2 {
+				return false, nil
+			}
+			challenge, err := state.hooks.Challenge(address)
+			if err != nil {
+				return false, err
+			}
+			candidate = &externalCandidate{challenge: challenge}
+			state.candidates[address] = candidate
+		}
+	}
+	candidate.info = packet.info
+	challenge, response, pureProbe, err := parseExternalProbe(payload, &c.frameParser, c.version)
+	if err != nil {
+		return false, nil
+	}
+	if challenge != nil {
+		candidate.response = *challenge
+		candidate.hasResponse = true
+	}
+	matched := response != nil && *response == candidate.challenge && candidate.hasResponse
+	if matched && state.server {
+		if err := state.hooks.Validated(address, *response); err != nil {
+			return false, err
+		}
+	}
+	// 客户端确认服务端回程后仍需发回服务端挑战，丢包由服务端探测重传恢复。
+	if matched && !state.server {
+		if err := c.sendExternalProbe(address, candidate); err != nil {
+			return false, err
+		}
+	}
+	if matched {
+		state.info = candidate.info
+		c.conn.ChangeRemoteAddr(net.UDPAddrFromAddrPort(address), candidate.info)
+		// 匹配路径后，这个报文中的其余帧才允许交给普通 QUIC 状态机。
+		_, _, err := c.handleUnpackedShortHeaderPacket(protocol.ParseConnectionID(packet.data[1:17]), pn, payload, protocol.ECNNon, packet.rcvTime, nil)
+		return err == nil, err
+	}
+	if pureProbe {
+		c.largestRcvdAppData = max(c.largestRcvdAppData, pn)
+		if err := c.receivedPacketHandler.ReceivedPacket(pn, protocol.ECNNon, protocol.Encryption1RTT, packet.rcvTime, false); err != nil {
+			return false, err
+		}
+	}
+	// 没收到己方挑战的有效回包时，禁止把新来源设为常规发送目的地。
+	return false, nil
+}
+
+func parseExternalProbe(data []byte, parser *wire.FrameParser, version protocol.Version) (challenge, response *[8]byte, pure bool, err error) {
+	pure = true
+	for len(data) > 0 {
+		kind, n, e := parser.ParseType(data, protocol.Encryption1RTT)
+		if e == io.EOF {
+			return
+		}
+		if e != nil {
+			err = e
+			return
+		}
+		data = data[n:]
+		if kind.IsStreamFrameType() {
+			frame, n, e := parser.ParseStreamFrame(kind, data, version)
+			if e != nil {
+				err = e
+				return
+			}
+			frame.PutBack()
+			data = data[n:]
+			pure = false
+		} else if kind.IsAckFrameType() {
+			_, n, e := parser.ParseAckFrame(kind, data, protocol.Encryption1RTT, version)
+			if e != nil {
+				err = e
+				return
+			}
+			data = data[n:]
+		} else if kind.IsDatagramFrameType() {
+			_, n, e := parser.ParseDatagramFrame(kind, data, version)
+			if e != nil {
+				err = e
+				return
+			}
+			data = data[n:]
+			pure = false
+		} else {
+			frame, n, e := parser.ParseLessCommonFrame(kind, data, version)
+			if e != nil {
+				err = e
+				return
+			}
+			data = data[n:]
+			switch frame := frame.(type) {
+			case *wire.PathChallengeFrame:
+				v := frame.Data
+				challenge = &v
+			case *wire.PathResponseFrame:
+				v := frame.Data
+				response = &v
+			case *wire.PingFrame:
+			default:
+				pure = false
+			}
+		}
+	}
+	return
+}
+
+func (c *Conn) sendExternalProbe(address netip.AddrPort, candidate *externalCandidate) error {
+	state := c.externalPath
+	const size = 1200
+	if state.server {
+		// 预算不足只等待新的合法输入；不通过发送 CLOSE 或 ACK 绕过限制。
+		if err := state.hooks.ReserveSend(address, size); err != nil {
+			return nil
+		}
+	}
+	sealer, err := c.cryptoStreamHandler.(*handshake.ExternalCryptoSetup).Get1RTTSealer()
+	if err != nil {
+		return err
+	}
+	pn := c.sentPacketHandler.PopPacketNumber(protocol.Encryption1RTT)
+	header, err := wire.AppendShortHeader(nil, c.handshakeDestConnID, pn, protocol.PacketNumberLen4, protocol.KeyPhaseZero)
+	if err != nil {
+		return err
+	}
+	payload, _ := (&wire.PathChallengeFrame{Data: candidate.challenge}).Append(nil, c.version)
+	if candidate.hasResponse {
+		payload, _ = (&wire.PathResponseFrame{Data: candidate.response}).Append(payload, c.version)
+	}
+	payload = append(payload, make([]byte, size-len(header)-sealer.Overhead()-len(payload))...)
+	packet := sealer.Seal(header, payload, pn, header)
+	sealer.EncryptHeader(packet[len(header):len(header)+16], &packet[0], packet[len(header)-4:len(header)])
+	// 探测自行定时重发，不加入业务重传队列；仍登记所有已发包号，后续 ACK 不会被视为确认未发送包。
+	c.sentPacketHandler.SentPacket(monotime.Now(), pn, protocol.InvalidPacketNumber, nil, nil, protocol.Encryption1RTT, protocol.ECNNon, size, false, false)
+	c.sentFirstPacket = true
+	return c.conn.WriteTo(packet, net.UDPAddrFromAddrPort(address), candidate.info)
+}
