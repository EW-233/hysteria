+// 网络测试直接导入临时密钥，预算仍按实际经过 AEAD 的路径回调计算。
+func externalNetworkTestPair(t *testing.T) (*Conn, *Conn, *externalTestPacketConn, *externalTestPacketConn) {
+	t.Helper()
+	cs, ss := externalTestSocket(t), externalTestSocket(t)
+	ct, st := &Transport{Conn: cs, DisableGSO: true}, &Transport{Conn: ss, DisableGSO: true}
+	t.Cleanup(func() { ct.Close(); st.Close() })
+	cfg := externalTestConfig()
+	clientCID, serverCID := [16]byte{1}, [16]byte{2}
+	cp, err := ExternalLoopbackParameters(false, clientCID, serverCID, cfg)
+	require.NoError(t, err)
+	sp, err := ExternalLoopbackParameters(true, serverCID, clientCID, cfg)
+	require.NoError(t, err)
+	received, sent := make(map[netip.AddrPort]int), make(map[netip.AddrPort]int)
+	hooks := &ExternalPathHooks{
+		Authenticated: func(a netip.AddrPort, n int) error { received[a] += n; return nil },
+		Challenge:     func(netip.AddrPort) ([8]byte, error) { return [8]byte{7}, nil },
+		ReserveSend: func(a netip.AddrPort, n int) error {
+			if sent[a]+n > 3*received[a] {
+				return errors.New("budget")
+			}
+			sent[a] += n
+			return nil
+		},
+		Validated: func(_ netip.AddrPort, b [8]byte) error {
+			if b != [8]byte{7} {
+				return errors.New("challenge")
+			}
+			return nil
+		},
+	}
+	server, err := st.RegisterExternal(context.Background(), nil, cfg, ExternalLoopbackConfig{Server: true, LocalCID: serverCID, PeerCID: clientCID, ReadSecret: [32]byte{1}, WriteSecret: [32]byte{2}, PeerParameters: cp}, time.Now().Add(5*time.Second), hooks)
+	require.NoError(t, err)
+	client, err := ct.RegisterExternal(context.Background(), ss.LocalAddr(), cfg, ExternalLoopbackConfig{LocalCID: clientCID, PeerCID: serverCID, ReadSecret: [32]byte{2}, WriteSecret: [32]byte{1}, PeerParameters: sp}, time.Now().Add(5*time.Second), nil)
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	require.NoError(t, client.AwaitExternalPath(ctx))
+	require.NoError(t, server.AwaitExternalPath(ctx))
+	return client, server, cs, ss
+}
