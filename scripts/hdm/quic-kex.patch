+	"github.com/apernet/quic-go/internal/wire"
+)
+
+// ExternalLoopbackConfig 仅供回环 PoC；不是可公开部署的外部握手 API。
+// 真实网络必须先实现路径验证、反放大与业务就绪，不能去掉地址检查后直接复用。
+type ExternalLoopbackConfig struct {
+	Server         bool
+	LocalCID       [16]byte
+	PeerCID        [16]byte
+	ReadSecret     [32]byte
+	WriteSecret    [32]byte
+	PeerParameters []byte
+}
+
+// ExternalLoopbackParameters 生成待带外认证的参数；CID 必须与随后导入的连接一致。
+func ExternalLoopbackParameters(server bool, local, peer [16]byte, config *Config) ([]byte, error) {
+	if local == [16]byte{} || (server && peer == [16]byte{}) || local == peer {
+		return nil, errors.New("external QUIC: invalid CID")
+	}
+	cfg, err := externalConfig(config)
+	if err != nil {
+		return nil, err
+	}
+	perspective := protocol.PerspectiveClient
+	if server {
+		perspective = protocol.PerspectiveServer
+	}
+	params := &wire.TransportParameters{
+		InitialMaxStreamDataBidiLocal:  protocol.ByteCount(cfg.InitialStreamReceiveWindow),
+		InitialMaxStreamDataBidiRemote: protocol.ByteCount(cfg.InitialStreamReceiveWindow),
+		InitialMaxStreamDataUni:        protocol.ByteCount(cfg.InitialStreamReceiveWindow),
+		InitialMaxData:                 protocol.ByteCount(cfg.InitialConnectionReceiveWindow),
+		MaxIdleTimeout:                 cfg.MaxIdleTimeout, MaxBidiStreamNum: protocol.StreamNum(cfg.MaxIncomingStreams), MaxUniStreamNum: protocol.StreamNum(cfg.MaxIncomingUniStreams),
+		MaxAckDelay: protocol.MaxAckDelayInclGranularity, AckDelayExponent: protocol.AckDelayExponent,
+		MaxUDPPayloadSize: protocol.MaxPacketBufferSize, ActiveConnectionIDLimit: protocol.MaxActiveConnectionIDs,
+		InitialSourceConnectionID: protocol.ParseConnectionID(local[:]), DisableActiveMigration: true,
+		MaxDatagramFrameSize: protocol.InvalidByteCount,
+	}
+	if cfg.EnableDatagrams {
+		params.MaxDatagramFrameSize = wire.MaxDatagramSize
+		if cfg.MaxDatagramFrameSize != 0 {
+			params.MaxDatagramFrameSize = protocol.ByteCount(cfg.MaxDatagramFrameSize)
+		}
+	}
+	if server {
+		params.OriginalDestinationConnectionID = protocol.ParseConnectionID(local[:])
+	}
+	return params.Marshal(perspective), nil
+}
+func externalConfig(config *Config) (*Config, error) {
+	if config == nil {
+		config = &Config{}
+	}
+	cfg := config.Clone()
+	if cfg.ChromeParrot || cfg.Allow0RTT || cfg.TokenStore != nil || cfg.DisablePathManager || cfg.OmitMaxDatagramFrameSize || cfg.AssumePeerMaxDatagramFrameSize != 0 || cfg.EnableStreamResetPartialDelivery || cfg.Tracer != nil || cfg.GetConfigForClient != nil {
+		return nil, errors.New("external QUIC: unsupported configuration")
+	}
+	if len(cfg.Versions) > 0 && (len(cfg.Versions) != 1 || cfg.Versions[0] != Version1) {
+		return nil, errors.New("external QUIC: only version 1 is supported")
+	}
+	if err := validateConfig(cfg); err != nil {
+		return nil, err
+	}
+	cfg.Versions = []Version{Version1}
+	cfg.DisablePathMTUDiscovery = true
+	return populateConfig(cfg), nil
+}
+func externalLoopbackAddress(addr net.Addr) bool {
+	a, ok := addr.(*net.UDPAddr)
+	return ok && a.Port > 0 && a.IP.IsLoopback() && a.Zone == ""
+}
+
+// NewExternalLoopback 只创建外部密钥数据面；TLS.ConnectionState 保持未握手状态。
+// 该入口每个 Transport 只能使用一次，失败后也必须关闭并创建新的 Transport。
+func (t *Transport) NewExternalLoopback(ctx context.Context, remote net.Addr, config *Config, x ExternalLoopbackConfig) (*Conn, error) {
+	if t.Conn == nil || !externalLoopbackAddress(t.Conn.LocalAddr()) || !externalLoopbackAddress(remote) {
+		return nil, errors.New("external QUIC: loopback addresses required")
+	}
+	return t.newExternal(ctx, remote, config, x, nil)
+}
+
+func (t *Transport) newExternal(ctx context.Context, remote net.Addr, config *Config, x ExternalLoopbackConfig, path *externalPathState) (*Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	defer clear(x.ReadSecret[:])
+	defer clear(x.WriteSecret[:])
+	if t.Conn == nil || x.LocalCID == [16]byte{} || x.PeerCID == [16]byte{} || x.LocalCID == x.PeerCID || x.ReadSecret == [32]byte{} || x.WriteSecret == [32]byte{} || x.ReadSecret == x.WriteSecret || fips140.Enabled() {
+		return nil, errors.New("external QUIC: loopback addresses and distinct keys required")
+	}
+	if len(x.PeerParameters) == 0 || len(x.PeerParameters) > 4096 {
+		return nil, errors.New("external QUIC: invalid transport parameters")
+	}
+	cfg, err := externalConfig(config)
+	if err != nil {
+		return nil, err
+	}
+	perspective := protocol.PerspectiveClient
+	if x.Server {
+		perspective = protocol.PerspectiveServer
+	}
+	params := &wire.TransportParameters{}
+	if err = params.Unmarshal(x.PeerParameters, perspective.Opposite()); err != nil {
+		return nil, err
+	}
+	peer := protocol.ParseConnectionID(x.PeerCID[:])
+	local := protocol.ParseConnectionID(x.LocalCID[:])
+	if params.InitialSourceConnectionID != peer || params.PreferredAddress != nil || params.RetrySourceConnectionID != nil || params.StatelessResetToken != nil || !params.DisableActiveMigration || params.EnableResetStreamAt || (!x.Server && params.OriginalDestinationConnectionID != peer) {
+		return nil, errors.New("external QUIC: parameter binding mismatch")
+	}
+	t.mutex.Lock()
+	if t.closeErr != nil || (t.externalImported && !(path != nil && x.Server && t.externalListener)) || t.server != nil || (t.conn != nil && !t.externalListener) || t.ConnectionIDGenerator != nil || (t.ConnectionIDLength != 0 && t.ConnectionIDLength != 16) || t.Tracer != nil {
+		t.mutex.Unlock()
+		return nil, errors.New("external QUIC: dedicated fresh transport required")
+	}
+	if t.handlers != nil {
+		if _, exists := t.handlers[local]; exists {
+			t.mutex.Unlock()
+			return nil, errors.New("external QUIC: CID collision")
+		}
+	}
+	t.externalImported = true
+	t.externalListener = path != nil && x.Server
+	t.ConnectionIDLength = 16
+	if err = t.init(false); err != nil {
+		t.mutex.Unlock()
+		return nil, err
+	}
+	parent := ctx
+	ctx, cancel := context.WithCancelCause(context.WithoutCancel(parent))
+	udpRemote := remote.(*net.UDPAddr)
+	remote = &net.UDPAddr{IP: bytes.Clone(udpRemote.IP), Port: udpRemote.Port}
+	c := &Conn{ctx: ctx, ctxCancel: cancel, conn: newSendConn(t.conn, remote, packetInfo{}, utils.DefaultLogger), config: cfg,
+		origDestConnID: peer, handshakeDestConnID: peer, srcConnIDLen: 16, oneRTTStream: newCryptoStream(), perspective: perspective,
+		logID: local.String(), logger: utils.DefaultLogger, version: protocol.Version1, versionNegotiated: true,
+		externalConfirm:            make(chan chan error, 1),
+		externalAllowPeerKeyUpdate: make(chan externalKeyUpdateRequest, 1),
+		externalConfirmed:          make(chan struct{}),
+		externalPath:               path,
+	}
+	runner := (*packetHandlerMap)(t)
+	c.connIDManager = newConnIDManager(peer, func(token protocol.StatelessResetToken) { runner.AddResetToken(token, c) }, runner.RemoveResetToken, c.queueControlFrame)
+	c.connIDGenerator = newConnIDGenerator(runner, local, nil, t.statelessResetter, connRunnerCallbacks{
+		AddConnectionID: func(id protocol.ConnectionID) { runner.Add(id, c) }, RemoveConnectionID: runner.Remove,
+		// 关闭后的回复仍绑定已验证路径，不能退回普通关闭处理器的任意来源回复。
+		ReplaceWithClosed: func(ids []protocol.ConnectionID, packet []byte, expiry time.Duration) {
+			var info packetInfo
+			if path != nil {
+				info = path.info
+			}
+			runner.replaceWithClosed(ids, packet, expiry, c.RemoteAddr(), info)
+		},
+	}, c.queueControlFrame, t.connIDGenerator)
+	c.preSetup()
+	c.sentPacketHandler = ackhandler.NewSentPacketHandler(0, protocol.ByteCount(cfg.InitialPacketSize), c.rttStats, &c.connStats, true, c.conn.capabilities().ECN, c.receivedPacketHandler.IgnorePacketsBelow, perspective, false, nil, c.logger)
+	c.maxPayloadSizeEstimate.Store(uint32(estimateMaxPayloadSize(protocol.ByteCount(cfg.InitialPacketSize))))
+	cs := handshake.NewExternalCryptoSetup(x.ReadSecret, x.WriteSecret, c.rttStats)
+	c.cryptoStreamHandler = cs
+	c.packer = newPacketPacker(local, c.connIDManager.Get, c.initialStream, c.handshakeStream, c.sentPacketHandler, c.retransmissionQueue, cs, c.framer, &c.receivedPacketHandler, c.datagramQueue, perspective, false)
+	c.unpacker = newPacketUnpacker(cs, 16)
+	c.cryptoStreamManager = newCryptoStreamManager(c.initialStream, c.handshakeStream, c.oneRTTStream)
+	t.handlers[local] = c
+	t.mutex.Unlock()
+	// 此时只有本地导入的密钥与已认证参数；confirmed 仍等待显式的控制协议确认。
+	c.peerParams = params
+	c.applyTransportParameters()
+	now := monotime.Now()
+	c.dropEncryptionLevel(protocol.EncryptionInitial, now)
+	c.dropEncryptionLevel(protocol.EncryptionHandshake, now)
+	c.connIDManager.SetHandshakeComplete()
+	c.connIDGenerator.SetHandshakeComplete(now.Add(3 * c.rttStats.PTO(false)))
+	c.handshakeComplete = true
+	close(c.handshakeCompleteChan)
+	go c.run()
+	go func() {
+		select {
+		case <-parent.Done():
+			if path != nil {
+				select {
+				case <-path.ready:
+					// 已验证路径可发送受保护关闭，让客户端立即感知撤销；待接入路径保持静默关闭。
+					c.CloseWithError(0x100, "external authorization ended")
+					return
+				default:
+				}
+			}
+			c.destroy(context.Cause(parent))
+		case <-c.ctx.Done():
+		}
+	}()
+	return c, nil
+}
+
+// ConfirmExternalLoopback 仅由回环测试在完成应用层双向确认后调用，在连接主循环中执行。
+func (c *Conn) ConfirmExternalLoopback(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if c.externalConfirm == nil || c.externalPath != nil {
+		return errors.New("external QUIC: not an external loopback connection")
+	}
+	response := make(chan error, 1)
+	select {
+	case c.externalConfirm <- response:
+		c.scheduleSending()
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+	select {
+	case err := <-response:
+		return err
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	case <-c.ctx.Done():
+		return context.Cause(c.ctx)
+	}
+}
+
+// 外部模式没有普通 TLS 握手完成事件，不发送 NEW_TOKEN、ticket 或 HANDSHAKE_DONE。
+func (c *Conn) processExternalConfirmation() {
+	// 许可事件由连接主循环处理，和解密、密钥更新共享同一执行顺序。
+	select {
+	case request := <-c.externalAllowPeerKeyUpdate:
+		err := request.ctx.Err()
+		if err == nil {
+			if c.externalPath == nil || !c.externalPath.verified {
+				err = errors.New("external QUIC: path unverified")
+			} else {
+				c.cryptoStreamHandler.(*handshake.ExternalCryptoSetup).AllowPeerKeyUpdate()
+			}
+		}
+		request.result <- err
+	default:
+	}
+
+	select {
+	case result := <-c.externalConfirm:
+		var err error
+		if c.externalPath != nil && !c.externalPath.verified {
+			err = errors.New("external QUIC: path unverified")
+		} else if !c.handshakeConfirmed {
+			err = c.handleHandshakeConfirmed(monotime.Now())
+			if err == nil {
+				close(c.externalConfirmed)
+			}
+		}
+		result <- err
+	default:
+	}
+}
