+//go:build kex_poc
+
+package quic
+
+import (
+	"context"
+	"errors"
+
+	"github.com/apernet/quic-go/internal/protocol"
+	"github.com/apernet/quic-go/internal/wire"
+)
+
+// SendDatagramContext 在队列满时允许取消当前入队，不影响共享连接。
+// 成功入队后的报文仍遵循 SendDatagram 的语义，取消不撤回已入队的报文。
+func (c *Conn) SendDatagramContext(ctx context.Context, p []byte) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !c.supportsDatagrams() {
+		return errors.New("datagram support disabled")
+	}
+	f := &wire.DatagramFrame{DataLenPresent: true}
+	maxDataLen := min(f.MaxDataLen(c.peerMaxDatagramFrameSize(), c.version), protocol.ByteCount(c.maxPayloadSizeEstimate.Load()))
+	if protocol.ByteCount(len(p)) > maxDataLen {
+		return &DatagramTooLargeError{MaxDatagramPayloadSize: int64(maxDataLen)}
+	}
+	f.Data = append([]byte(nil), p...)
+	return c.datagramQueue.addContext(ctx, f)
+}
+
+// 等待与取消都发生在真实发送队列；取消的等待者必须把可用槽位通知交给其他等待者。
+func (h *datagramQueue) addContext(ctx context.Context, f *wire.DatagramFrame) error {
+	for {
+		h.sendMx.Lock()
+		err := ctx.Err()
+		select {
+		case <-h.closed:
+			err = h.closeErr
+		default:
+		}
+		if err != nil {
+			if h.sendQueue.Len() < maxDatagramSendQueueLen {
+				select {
+				case h.sent <- struct{}{}:
+				default:
+				}
+			}
+			h.sendMx.Unlock()
+			return err
+		}
+		if h.sendQueue.Len() < maxDatagramSendQueueLen {
+			h.sendQueue.PushBack(f)
+			// 多次出队的通知可能合并；仍有空位时继续唤醒下一个会话。
+			if h.sendQueue.Len() < maxDatagramSendQueueLen {
+				select {
+				case h.sent <- struct{}{}:
+				default:
+				}
+			}
+			h.sendMx.Unlock()
+			h.hasData()
+			return nil
+		}
+		h.sendMx.Unlock()
+		select {
+		case <-ctx.Done():
+		case <-h.closed:
+		case <-h.sent:
+		}
+	}
+}
