+package handshake
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+	"github.com/apernet/quic-go/internal/utils"
+	"github.com/stretchr/testify/require"
+)
+
+// 使用真实 QUIC 包保护器，覆盖确认前更新拒绝及更新后的旧包乱序。
+func TestExternalCryptoKeyUpdateAndReordering(t *testing.T) {
+	client := NewExternalCryptoSetup([32]byte{2}, [32]byte{1}, utils.NewRTTStats())
+	server := NewExternalCryptoSetup([32]byte{1}, [32]byte{2}, utils.NewRTTStats())
+	old0 := client.aead.Seal(nil, []byte("initial"), 0, []byte("ad"))
+	old1 := client.aead.Seal(nil, []byte("reordered"), 1, []byte("ad"))
+	plain, err := server.Open(nil, old0, monotime.Now(), 0, protocol.KeyPhaseZero, []byte("ad"))
+	require.NoError(t, err)
+	require.Equal(t, []byte("initial"), plain)
+	client.aead.numSentWithCurrentKey = FirstKeyUpdateInterval
+	require.Equal(t, protocol.KeyPhaseZero, client.aead.KeyPhase(), "must not update before confirmation")
+	client.SetHandshakeConfirmed()
+	require.Equal(t, protocol.KeyPhaseOne, client.aead.KeyPhase())
+	// 第一个新阶段包丢失，仅第二个到达时也能恢复密钥阶段。
+	_ = client.aead.Seal(nil, []byte("lost"), 2, []byte("ad"))
+	updated := client.aead.Seal(nil, []byte("updated"), 3, []byte("ad"))
+	_, err = server.Open(nil, updated, monotime.Now(), 3, protocol.KeyPhaseOne, []byte("ad"))
+	require.ErrorIs(t, err, ErrDecryptionFailed)
+	server.SetHandshakeConfirmed()
+	plain, err = server.Open(nil, updated, monotime.Now(), 3, protocol.KeyPhaseOne, []byte("ad"))
+	require.NoError(t, err)
+	require.Equal(t, []byte("updated"), plain)
+	require.Equal(t, protocol.KeyPhaseOne, server.aead.KeyPhase())
+	plain, err = server.Open(nil, old1, monotime.Now(), 1, protocol.KeyPhaseZero, []byte("ad"))
+	require.NoError(t, err)
+	require.Equal(t, []byte("reordered"), plain)
+	reply := server.aead.Seal(nil, []byte("ack"), 0, []byte("ad"))
+	plain, err = client.Open(nil, reply, monotime.Now(), 0, protocol.KeyPhaseOne, []byte("ad"))
+	require.NoError(t, err)
+	require.Equal(t, []byte("ack"), plain)
+	require.NoError(t, client.SetLargest1RTTAcked(3))
+	// 没有对新阶段的 ACK 时不能连续更新；收到后复用标准 quic ku 流程。
+	client.aead.numSentWithCurrentKey = keyUpdateInterval.Load()
+	require.Equal(t, protocol.KeyPhaseZero, client.aead.KeyPhase())
+	next := client.aead.Seal(nil, []byte("second update"), 4, []byte("ad"))
+	plain, err = server.Open(nil, next, monotime.Now(), 4, protocol.KeyPhaseZero, []byte("ad"))
+	require.NoError(t, err)
+	require.Equal(t, []byte("second update"), plain)
+}
+func TestExternalCryptoNoTLSAndLongHeaderKeys(t *testing.T) {
+	c := NewExternalCryptoSetup([32]byte{2}, [32]byte{1}, utils.NewRTTStats())
+	require.NoError(t, c.StartHandshake(context.Background()))
+	require.Equal(t, EventNoEvent, c.NextEvent().Kind)
+	require.False(t, c.ConnectionState().HandshakeComplete)
+	_, err := c.GetInitialSealer()
+	require.ErrorIs(t, err, ErrKeysDropped)
+	_, err = c.GetHandshakeSealer()
+	require.ErrorIs(t, err, ErrKeysDropped)
+	_, err = c.Get0RTTSealer()
+	require.ErrorIs(t, err, ErrKeysDropped)
+	_, err = c.GetInitialOpener()
+	require.ErrorIs(t, err, ErrKeysDropped)
+	_, err = c.GetHandshakeOpener()
+	require.ErrorIs(t, err, ErrKeysDropped)
+	_, err = c.Get0RTTOpener()
+	require.ErrorIs(t, err, ErrKeysDropped)
+	require.Error(t, c.HandleMessage([]byte("TLS"), protocol.Encryption1RTT))
+	token, err := c.GetSessionTicket()
+	require.NoError(t, err)
+	require.Nil(t, token)
+	require.NoError(t, c.Close())
+	// 上层先关闭握手器再编码 CONNECTION_CLOSE，不能在 Close 时清空 AEAD 造成崩溃。
+	sealer, err := c.Get1RTTSealer()
+	require.NoError(t, err)
+	require.NotEmpty(t, sealer.Seal(nil, bytes.Repeat([]byte{1}, 16), 0, nil))
+}
+
+// 复现接入阶段重复解密达到首次更新阈值，再以新阶段发送 START。
+func TestExternalCryptoReadyAllowsPeerUpdateWithoutConfirmation(t *testing.T) {
+	client := NewExternalCryptoSetup([32]byte{2}, [32]byte{1}, utils.NewRTTStats())
+	server := NewExternalCryptoSetup([32]byte{1}, [32]byte{2}, utils.NewRTTStats())
+	ad := []byte("authenticated header")
+	probe := client.aead.Seal(nil, []byte("PATH_CHALLENGE"), 0, ad)
+	ready := server.aead.Seal(nil, []byte("READY"), 0, ad)
+	for range 100 {
+		_, err := server.Open(nil, probe, monotime.Now(), 0, protocol.KeyPhaseZero, ad)
+		require.NoError(t, err)
+		_, err = client.Open(nil, ready, monotime.Now(), 0, protocol.KeyPhaseZero, ad)
+		require.NoError(t, err)
+	}
+	require.EqualValues(t, 100, server.aead.numRcvdWithCurrentKey)
+	require.Equal(t, protocol.KeyPhaseZero, server.aead.KeyPhase())
+	// READY 许可本身不确认握手，达到阈值也不能主动更新。
+	client.AllowPeerKeyUpdate()
+	client.AllowPeerKeyUpdate()
+	require.False(t, client.confirmed)
+	require.False(t, client.aead.handshakeConfirmed)
+	require.Equal(t, protocol.KeyPhaseZero, client.aead.KeyPhase())
+	server.SetHandshakeConfirmed()
+	require.Equal(t, protocol.KeyPhaseOne, server.aead.KeyPhase())
+	start := server.aead.Seal(nil, []byte("START"), 1, ad)
+	plain, err := client.Open(nil, start, monotime.Now(), 1, protocol.KeyPhaseOne, ad)
+	require.NoError(t, err)
+	require.Equal(t, []byte("START"), plain)
+	require.False(t, client.confirmed)
+	require.False(t, client.aead.handshakeConfirmed)
+	require.Equal(t, protocol.KeyPhaseOne, client.aead.KeyPhase())
+	// 跟随对端更新后，也不能在业务确认之前自行滚动下一阶段。
+	_ = client.aead.Seal(nil, []byte("ack"), 1, ad)
+	peerAck := server.aead.Seal(nil, []byte("peer ack"), 2, ad)
+	_, err = client.Open(nil, peerAck, monotime.Now(), 2, protocol.KeyPhaseOne, ad)
+	require.NoError(t, err)
+	require.NoError(t, client.SetLargest1RTTAcked(1))
+	client.aead.numSentWithCurrentKey = keyUpdateInterval.Load()
+	require.Equal(t, protocol.KeyPhaseOne, client.aead.KeyPhase())
+	client.SetHandshakeConfirmed()
+	require.True(t, client.confirmed)
+	require.Equal(t, protocol.KeyPhaseZero, client.aead.KeyPhase())
+}
+
+// 待接入连接仍拒绝真实 phase 1，即使该包能通过下一阶段 AEAD。
+func TestExternalCryptoRejectsEarlyPeerUpdate(t *testing.T) {
+	client := NewExternalCryptoSetup([32]byte{2}, [32]byte{1}, utils.NewRTTStats())
+	server := NewExternalCryptoSetup([32]byte{1}, [32]byte{2}, utils.NewRTTStats())
+	server.SetHandshakeConfirmed()
+	for pn := protocol.PacketNumber(0); pn < 100; pn++ {
+		server.aead.Seal(nil, []byte("probe"), pn, nil)
+	}
+	require.Equal(t, protocol.KeyPhaseOne, server.aead.KeyPhase())
+	packet := server.aead.Seal(nil, []byte("early"), 100, nil)
+	_, err := client.Open(nil, packet, monotime.Now(), 100, protocol.KeyPhaseOne, nil)
+	require.ErrorIs(t, err, ErrDecryptionFailed)
+	require.Equal(t, protocol.KeyPhaseZero, client.aead.KeyPhase())
+	client.AllowPeerKeyUpdate()
+	_, err = client.Open(nil, packet, monotime.Now(), 100, protocol.KeyPhaseOne, nil)
+	require.NoError(t, err)
+}
