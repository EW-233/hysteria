+package handshake
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+	"github.com/apernet/quic-go/internal/utils"
+)
+
+// ExternalCryptoSetup 只提供外部握手的数据面密钥，不生成任何 TLS 握手消息。
+type ExternalCryptoSetup struct {
+	aead      *updatableAEAD
+	confirmed bool
+}
+
+var _ CryptoSetup = (*ExternalCryptoSetup)(nil)
+
+func NewExternalCryptoSetup(read, write [32]byte, rtt *utils.RTTStats) *ExternalCryptoSetup {
+	a := newUpdatableAEAD(rtt, nil, utils.DefaultLogger, protocol.Version1)
+	suite := getCipherSuite(tls.TLS_CHACHA20_POLY1305_SHA256)
+	a.SetReadKey(suite, read[:])
+	a.SetWriteKey(suite, write[:])
+	clear(read[:])
+	clear(write[:])
+	return &ExternalCryptoSetup{aead: a}
+}
+func (*ExternalCryptoSetup) StartHandshake(context.Context) error { return nil }
+
+// CONNECTION_CLOSE 在 Close 之后编码，仍需保留包保护器直至连接释放。
+func (*ExternalCryptoSetup) Close() error                             { return nil }
+func (*ExternalCryptoSetup) ChangeConnectionID(protocol.ConnectionID) {}
+func (*ExternalCryptoSetup) GetSessionTicket() ([]byte, error)        { return nil, nil }
+func (*ExternalCryptoSetup) HandleMessage([]byte, protocol.EncryptionLevel) error {
+	return errors.New("external QUIC: unexpected CRYPTO frame")
+}
+func (*ExternalCryptoSetup) NextEvent() Event { return Event{Kind: EventNoEvent} }
+func (c *ExternalCryptoSetup) SetLargest1RTTAcked(pn protocol.PacketNumber) error {
+	return c.aead.SetLargestAcked(pn)
+}
+func (*ExternalCryptoSetup) DiscardInitialKeys() {}
+func (c *ExternalCryptoSetup) SetHandshakeConfirmed() {
+	c.confirmed = true
+	c.aead.SetHandshakeConfirmed()
+}
+func (*ExternalCryptoSetup) ConnectionState() ConnectionState            { return ConnectionState{} }
+func (*ExternalCryptoSetup) GetInitialOpener() (LongHeaderOpener, error) { return nil, ErrKeysDropped }
+func (*ExternalCryptoSetup) GetHandshakeOpener() (LongHeaderOpener, error) {
+	return nil, ErrKeysDropped
+}
+func (*ExternalCryptoSetup) Get0RTTOpener() (LongHeaderOpener, error)    { return nil, ErrKeysDropped }
+func (c *ExternalCryptoSetup) Get1RTTOpener() (ShortHeaderOpener, error) { return c, nil }
+func (*ExternalCryptoSetup) GetInitialSealer() (LongHeaderSealer, error) { return nil, ErrKeysDropped }
+func (*ExternalCryptoSetup) GetHandshakeSealer() (LongHeaderSealer, error) {
+	return nil, ErrKeysDropped
+}
+func (*ExternalCryptoSetup) Get0RTTSealer() (LongHeaderSealer, error)    { return nil, ErrKeysDropped }
+func (c *ExternalCryptoSetup) Get1RTTSealer() (ShortHeaderSealer, error) { return c.aead, nil }
+func (c *ExternalCryptoSetup) DecryptHeader(sample []byte, first *byte, pn []byte) {
+	c.aead.DecryptHeader(sample, first, pn)
+}
+func (c *ExternalCryptoSetup) DecodePacketNumber(pn protocol.PacketNumber, n protocol.PacketNumberLen) protocol.PacketNumber {
+	return c.aead.DecodePacketNumber(pn, n)
+}
+func (c *ExternalCryptoSetup) Open(dst, src []byte, now monotime.Time, pn protocol.PacketNumber, phase protocol.KeyPhaseBit, ad []byte) ([]byte, error) {
+	if !c.confirmed && phase != protocol.KeyPhaseZero {
+		return nil, ErrDecryptionFailed
+	}
+	return c.aead.Open(dst, src, now, pn, phase, ad)
+}
