+func TestExternalNetworkReadyKeyUpdateAfter100Decryptions(t *testing.T) {
+	client, server, cs, ss := externalNetworkTestPair(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cs.mu.Lock()
+	probe := bytes.Clone(cs.packets[0])
+	cs.mu.Unlock()
+	// 重复包不会增加路径预算，但在重复 PN 过滤之前确实经过 AEAD。
+	for range 100 {
+		_, err := cs.PacketConn.WriteTo(probe, ss.LocalAddr())
+		require.NoError(t, err)
+		time.Sleep(time.Millisecond)
+	}
+	done := make(chan error, 1)
+	go func() {
+		stream, err := server.AcceptStream(ctx)
+		if err != nil {
+			done <- err
+			return
+		}
+		stream.SetDeadline(time.Now().Add(5 * time.Second))
+		var b [1]byte
+		if _, err = io.ReadFull(stream, b[:]); err != nil {
+			done <- err
+			return
+		}
+		if _, err = stream.Write([]byte("R")); err != nil {
+			done <- err
+			return
+		}
+		if _, err = io.ReadFull(stream, b[:]); err != nil {
+			done <- err
+			return
+		}
+		if err = server.ConfirmExternal(ctx); err != nil {
+			done <- err
+			return
+		}
+		if _, err = stream.Write([]byte("START")); err == nil {
+			err = stream.Close()
+		}
+		done <- err
+	}()
+	stream, err := client.OpenStreamSync(ctx)
+	require.NoError(t, err)
+	require.NoError(t, stream.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err = stream.Write([]byte("H"))
+	require.NoError(t, err)
+	var ready [1]byte
+	_, err = io.ReadFull(stream, ready[:])
+	require.NoError(t, err)
+	require.Equal(t, byte('R'), ready[0])
+	require.NoError(t, client.AllowExternalPeerKeyUpdate(ctx))
+	require.NoError(t, client.AllowExternalPeerKeyUpdate(ctx))
+	select {
+	case <-client.externalConfirmed:
+		t.Fatal("READY 许可提前确认了握手")
+	default:
+	}
+	_, err = stream.Write([]byte("A"))
+	require.NoError(t, err)
+	require.NoError(t, stream.Close())
+	start, err := io.ReadAll(stream)
+	require.NoError(t, err)
+	require.Equal(t, []byte("START"), start)
+	require.NoError(t, <-done)
+	select {
+	case <-client.externalConfirmed:
+		t.Fatal("接收 START 提前确认了业务")
+	default:
+	}
+	require.NoError(t, client.ConfirmExternal(ctx))
+	require.NoError(t, client.SendDatagram([]byte("business")))
+	body, err := server.ReceiveDatagram(ctx)
+	require.NoError(t, err)
+	require.Equal(t, []byte("business"), body)
+	// 检查线上实际包，避免测试只是未触发 key update 的普通往返。
+	observer := handshake.NewExternalCryptoSetup([32]byte{2}, [32]byte{1}, utils.NewRTTStats())
+	observer.AllowPeerKeyUpdate()
+	unpacker := newPacketUnpacker(observer, 16)
+	ss.mu.Lock()
+	packets := make([][]byte, len(ss.packets))
+	for i, b := range ss.packets {
+		packets[i] = bytes.Clone(b)
+	}
+	ss.mu.Unlock()
+	updated := false
+	for _, b := range packets {
+		_, _, phase, _, err := unpacker.UnpackShortHeader(monotime.Now(), b)
+		require.NoError(t, err)
+		updated = updated || phase == protocol.KeyPhaseOne
+	}
+	require.True(t, updated, "必须实际发出 phase 1")
+}
